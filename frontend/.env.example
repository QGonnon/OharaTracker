# Frontend url (doit être identique à SITE_URL côté api/.env)
VITE_SITE_URL=http://localhost:5173

# Cible du proxy Vite en dev uniquement : l'app appelle l'API en relatif (/api), jamais cette URL.
VITE_API_URL=http://localhost:3000

VITE_GOOGLE_CLIENT_ID=

# Doit être identique à VAPID_PUBLIC_KEY côté api/.env
VITE_VAPID_PUBLIC_KEY=
