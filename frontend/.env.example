VITE_API_URL=http://localhost:3000
VITE_GOOGLE_CLIENT_ID=

# Doit être égale à VAPID_PUBLIC_KEY côté api/.env
VITE_VAPID_PUBLIC_KEY=

VITE_STRIPE_PUBLIC_KEY=
# SEO — origine publique du site, sans slash final.
# Doit être identique à SITE_URL côté api/.env : c'est l'URL qui apparaît dans
# les balises canonical, hreflang et Open Graph.
VITE_SITE_URL=http://localhost:5173
