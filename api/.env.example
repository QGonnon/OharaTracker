# Frontend url (doit être identique à VITE_SITE_URL côté frontend/.env)
SITE_URL=http://localhost:5173

# Origine publique de l'API (sert la CSP) : en prod single-origin, vaut SITE_URL.
PUBLIC_API_URL=http://localhost:3000

# JWT configuration
JWT_SECRET=

# Database configuration
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=

# Sequelize configuration
NODE_ENV=development

# API configuration
TMDB_API_KEY=

# Stripe configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_LITE=
STRIPE_PRICE_ID_PRO=

# SMTP — rapport hebdomadaire des sorties. Sans SMTP_HOST, l'envoi est désactivé.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Ohara Tracker <no-reply@oharatracker.com>

# Heure UTC d'envoi du rapport hebdomadaire
DIGEST_HOUR_UTC=9

# Web Push (VAPID) configuration — générer avec `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@ohara.local