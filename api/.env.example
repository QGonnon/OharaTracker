# Frontend configuration
APP_URL=http://localhost
APP_PORT=5173

# JWT configuration
JWT_SECRET=

# Database configuration
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=

# Sequelize configuration
NODE_ENV=development

# API configuration
TMDB_API_KEY=

# Stripe configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_LITE=
STRIPE_PRICE_ID_PRO=

# Web Push (VAPID) configuration — générer avec `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@ohara.local
# SEO — doit être identique à VITE_SITE_URL côté frontend/.env.
SITE_URL=http://localhost:5173

# Doit valoir exactement VITE_API_URL du frontend, sinon la CSP bloque les requêtes.
PUBLIC_API_URL=http://localhost:3000
