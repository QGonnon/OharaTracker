# Frontend configuration
APP_URL=http://localhost
APP_PORT=5173

# JWT configuration
JWT_SECRET=

# Database configuration
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=

# Sequelize configuration
NODE_ENV=development

# API configuration
TMDB_API_KEY=

# Stripe configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_LITE=
STRIPE_PRICE_ID_PRO=

# Web Push (VAPID) configuration — générer avec `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@ohara.local
# SEO — origine publique du site, sans slash final.
# Sert à construire les URL absolues du sitemap, des balises canonical et hreflang.
# Doit être identique à VITE_SITE_URL côté frontend/.env.
# Sans valeur, https://oharatracker.com est utilisé par défaut.
SITE_URL=http://localhost:5173

# Origine publique de l'API telle que le navigateur l'appelle.
# DOIT valoir exactement le VITE_API_URL du frontend.
# Si l'API est servie depuis une autre origine que le site, l'omettre fait
# bloquer toutes les requêtes de données par la Content-Security-Policy :
# l'application s'affiche mais reste vide, sans erreur côté serveur.
# Inutile si l'API et le site partagent la même origine.
PUBLIC_API_URL=http://localhost:3000
